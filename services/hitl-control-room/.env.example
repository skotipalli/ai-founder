# Copy to .env.local and fill in. Never commit .env.local.

# Claude API key (server-side only; never exposed to the browser).
# Not needed if you've signed in with `ant auth login`.
ANTHROPIC_API_KEY=

# Model used by all agents.
HITL_MODEL=claude-opus-5-5

# Shown in the header and given to the agents as context.
HITL_PROJECT=FNOL Processor
HITL_OWNER=Owner

# Optional: a file every agent reads as its project brief (relative to this folder).
HITL_PROJECT_BRIEF=../PROTOCOL.md

# Max agent-to-agent hand-off chain before it stops and asks the human.
HITL_MAX_HANDOFF_DEPTH=3
